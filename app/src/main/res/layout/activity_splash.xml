<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg">

    <!-- Decorative top circle -->
    <View
        android:id="@+id/circle_top"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/circle_accent"
        android:alpha="0.12"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"/>

    <!-- Decorative bottom circle -->
    <View
        android:id="@+id/circle_bottom"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/circle_accent"
        android:alpha="0.10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-60dp"/>

    <!-- HELLO Text - styled like iPhone SF Pro Display -->
    <TextView
        android:id="@+id/tv_hello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HELLO"
        android:textSize="78sp"
        android:textStyle="bold"
        android:textColor="@color/splash_text"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.03"
        android:includeFontPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVerticalBias="0.42"/>

    <!-- Thin underline accent -->
    <View
        android:id="@+id/divider_hello"
        android:layout_width="80dp"
        android:layout_height="3dp"
        android:background="@color/color_accent"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tv_hello"
        app:layout_constraintStart_toStartOf="@id/tv_hello"
        app:layout_constraintEnd_toEndOf="@id/tv_hello"/>

    <!-- Programmer credit -->
    <TextView
        android:id="@+id/tv_programmer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="المبرمج احمد امليمدي"
        android:textSize="12sp"
        android:textColor="@color/splash_text_sub"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.04"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/divider_hello"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Loading dots at bottom -->
    <LinearLayout
        android:id="@+id/loading_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_active"
            android:layout_marginHorizontal="4dp"/>
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_inactive"
            android:layout_marginHorizontal="4dp"/>
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_inactive"
            android:layout_marginHorizontal="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
