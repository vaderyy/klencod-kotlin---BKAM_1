<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/color_primary"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"/>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"/>

            <View android:layout_width="36dp" android:layout_height="36dp"/>
        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- Image picker area -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/iv_product_preview"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/iv_preview_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_add_image"/>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_image"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="إضافة صورة المنتج"
                android:fontFamily="sans-serif"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/color_primary_light"
                android:textColor="@color/color_primary"/>

            <!-- Product name -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_product_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="اسم المنتج"
                    android:textSize="15sp"
                    android:gravity="end"
                    android:imeOptions="actionNext"
                    android:fontFamily="sans-serif"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Size label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الحجم"
                android:textSize="14sp"
                android:textColor="@color/color_on_surface_variant"
                android:fontFamily="sans-serif"
                android:layout_marginTop="16dp"
                android:gravity="end"/>

            <!-- Size buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_size_small"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:text="صغير"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/color_surface"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_size_medium"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:text="متوسط"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/color_surface"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_size_large"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:text="كبير"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/color_surface"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_size_none"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:text="بدون"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/color_primary"/>

            </LinearLayout>

            <!-- Price -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="السعر (دينار)"
                    android:textSize="15sp"
                    android:gravity="end"
                    android:inputType="numberDecimal"
                    android:fontFamily="sans-serif"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:text="حفظ المنتج"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="14dp"
                app:backgroundTint="@color/color_primary"/>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
